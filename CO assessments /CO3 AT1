Q4

#include <stdio.h>

int main()
{
    float mat, tlb, hit;

    printf("Enter Memory Access Time (ns): ");
    scanf("%f", &mat);

    printf("Enter TLB Access Time (ns): ");
    scanf("%f", &tlb);

    printf("Enter TLB Hit Ratio (0 to 1): ");
    scanf("%f", &hit);

    printf("\nMemory Access Time without TLB = %.2f ns", 2*mat);
    printf("\nEffective Memory Access Time with TLB = %.2f ns",
           hit*(tlb+mat)+(1-hit)*(tlb+2*mat));

    return 0;
}

OUTPUT

Enter Memory Access Time (ns): 100
Enter TLB Access Time (ns): 20
Enter TLB Hit Ratio (0 to 1): 0.8

Memory Access Time without TLB = 200.00 ns
Effective Memory Access Time with TLB = 140.00 ns

