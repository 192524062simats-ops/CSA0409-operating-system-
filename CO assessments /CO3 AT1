#include <stdio.h>

int main()
{
    int base, limit, la;

    printf("Enter Base Register Value: ");
    scanf("%d", &base);

    printf("Enter Limit Register Value: ");
    scanf("%d", &limit);

    printf("Enter Logical Address: ");
    scanf("%d", &la);

    if (la >= 0 && la < limit)
        printf("\nValid Logical Address\nPhysical Address = %d", base + la);
    else
        printf("\nInvalid Logical Address!");

    return 0;
}

