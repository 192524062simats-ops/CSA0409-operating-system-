#include <stdio.h>

int main()
{
    int pt[10], n, size, page, offset;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    printf("Enter page size: ");
    scanf("%d", &size);

    for(int i=0;i<n;i++)
    {
        printf("Page %d: ", i);
        scanf("%d", &pt[i]);
    }

    printf("Enter page number: ");
    scanf("%d", &page);

    printf("Enter offset: ");
    scanf("%d", &offset);

    if(page<n && offset<size)
        printf("\nFrame Number = %d\nPhysical Address = %d", pt[page], pt[page]*size+offset);
    else
        printf("\nInvalid Page Number or Offset.");

    return 0;
}

